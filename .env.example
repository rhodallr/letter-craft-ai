# At least one key is required. Gemini is used first; Groq is the fallback.

# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Optional fallback. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
